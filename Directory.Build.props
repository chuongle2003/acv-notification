<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>
  <!-- GHSA-2m69-gcr7-jv3q: SQLitePCLRaw bundles e_sqlite3 < 3.50.2; no patched
       package exists yet. Local app reads trusted files only — revisit when a
       patched bundle ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-f32c-w444-8ppv" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qj66-m88j-hmgj" />
  </ItemGroup>
</Project>
