<Window x:Class="TaskTracker.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker.Windows"
        xmlns:views="clr-namespace:TaskTracker.Windows.Views"
        mc:Ignorable="d"
        Title="Windows Task Tracker" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nguồn dữ liệu:" FontSize="12" Foreground="Gray"/>
                <TextBlock Text="{Binding SourceFileName}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LastSyncStatus}" FontSize="12" Foreground="#0078D7" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Đọc lại ngay" Command="{Binding RefreshDataCommand}" Padding="16,8" Margin="0,0,8,0" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Content="Chọn file khác" Click="OnChangeSourceFileClick" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Settings" Click="OnSettingsClick" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="QUÁ HẠN" FontSize="12" Foreground="#B91C1C" FontWeight="Bold"/>
                    <TextBlock Text="{Binding OverdueCount}" FontSize="24" Foreground="#991B1B" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FEF3C7" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="ĐẾN HẠN HÔM NAY" FontSize="12" Foreground="#B45309" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DueTodayCount}" FontSize="24" Foreground="#92400E" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="CÒN 1 NGÀY" FontSize="12" Foreground="#A16207" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DueSoonCount}" FontSize="24" Foreground="#854D0E" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="CẦN RÀ SOÁT" FontSize="12" Foreground="#4B5563" FontWeight="Bold"/>
                    <TextBlock Text="{Binding NeedsReviewCount}" FontSize="24" Foreground="#374151" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="BÌNH THƯỜNG" FontSize="12" Foreground="#475569" FontWeight="Bold"/>
                    <TextBlock Text="{Binding NormalCount}" FontSize="24" Foreground="#334155" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="HOÀN THÀNH" FontSize="12" Foreground="#15803D" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CompletedCount}" FontSize="24" Foreground="#166534" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Sheet:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox Width="110" ItemsSource="{Binding SheetOptions}" SelectedItem="{Binding SelectedSheet}"/>
                <TextBlock Text="Xử lý:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox Width="130" ItemsSource="{Binding HandlerOptions}" SelectedItem="{Binding SelectedHandler}"/>
                <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <ComboBox Width="120" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
            </StackPanel>

            <CheckBox Grid.Column="2" Content="Chỉ hiện chưa xem" IsChecked="{Binding ShowUnreadOnly}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main Content: Tabs for Task list and Deadline review -->
        <TabControl Grid.Row="3" BorderThickness="0" Background="Transparent">

            <TabItem Header="Danh sách nhiệm vụ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding TasksView}" SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,8,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Đã xem" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsAcknowledged, Mode=OneWay}"
                                                  Command="{Binding AcknowledgeCommand}"
                                                  IsEnabled="{Binding CanAcknowledge}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mức độ" Binding="{Binding CurrentStatus}" />
                            <DataGridTextColumn Header="Sheet" Binding="{Binding SheetName}" />
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" />
                            <DataGridTextColumn Header="Số CV" Binding="{Binding DocumentNumber}" Width="120" />
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding TaskContent}" Width="*" />
                            <DataGridTextColumn Header="Xử lý chính" Binding="{Binding PrimaryHandler}" />
                            <DataGridTextColumn Header="Thời hạn gốc" Binding="{Binding DeadlineRaw}" />
                            <DataGridTextColumn Header="Ngày đã resolve" Binding="{Binding ResolvedStartDate}" />
                            <DataGridTextColumn Header="Còn lại (ngày)" Binding="{Binding DaysRemaining}" />
                            <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" />
                            <DataGridTextColumn Header="Dòng" Binding="{Binding SourceRowNumber}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Detail Panel -->
                    <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="CHI TIẾT NHIỆM VỤ" FontWeight="Bold" FontSize="14" Margin="0,0,0,16" Foreground="#374151"/>

                                <TextBlock Text="Số công văn:" FontSize="12" Foreground="Gray"/>
                                <TextBox Text="{Binding SelectedTask.DocumentNumber, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Nội dung:" FontSize="12" Foreground="Gray"/>
                                <TextBox Text="{Binding SelectedTask.TaskContent, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Đơn vị / Xử lý chính:" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedTask.PrimaryHandler}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Sheet nguồn:" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedTask.SheetName}" Margin="0,0,0,16"/>

                                <Separator Margin="0,0,0,16"/>

                                <TextBlock Text="Trạng thái cảnh báo:" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedTask.CurrentStatus}" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,0,0,8"/>

                                <TextBlock Text="Thời hạn gốc:" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedTask.DeadlineRaw}" Margin="0,0,0,8"/>

                                <TextBlock Text="Ô nguồn:" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedTask.DeadlineCellAddress}" Margin="0,0,0,8"/>

                                <Button Content="Đã xem" Command="{Binding SelectedTask.AcknowledgeCommand}"
                                        Padding="8" Margin="0,16,0,0" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                                <Button Content="Xóa sửa chữa cục bộ" Click="OnResetCorrectionClick"
                                        Padding="8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Rà soát ngày tháng">
                <ContentControl x:Name="ReviewHost"/>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
