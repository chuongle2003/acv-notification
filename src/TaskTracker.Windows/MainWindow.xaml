<Window x:Class="TaskTracker.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker.Windows"
        mc:Ignorable="d"
        Title="Windows Task Tracker" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nguồn dữ liệu:" FontSize="12" Foreground="Gray"/>
                <TextBlock Text="{Binding SourceFileName}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LastSyncStatus}" FontSize="12" Foreground="#0078D7" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Đọc lại ngay" Command="{Binding RefreshDataCommand}" Padding="16,8" Margin="0,0,8,0" IsEnabled="{Binding IsLoading, Converter={x:Static local:InverseBooleanConverter.Instance}}"/>
                <Button Content="Chọn file khác" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Settings" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="QUÁ HẠN" FontSize="12" Foreground="#B91C1C" FontWeight="Bold"/>
                    <TextBlock Text="{Binding OverdueCount}" FontSize="24" Foreground="#991B1B" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FEF3C7" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="ĐẾN HẠN HÔM NAY" FontSize="12" Foreground="#B45309" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DueTodayCount}" FontSize="24" Foreground="#92400E" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="CÒN 1 NGÀY" FontSize="12" Foreground="#A16207" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DueSoonCount}" FontSize="24" Foreground="#854D0E" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel>
                    <TextBlock Text="CẦN RÀ SOÁT" FontSize="12" Foreground="#4B5563" FontWeight="Bold"/>
                    <TextBlock Text="{Binding NeedsReviewCount}" FontSize="24" Foreground="#374151" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Placeholder for DataGrid -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Background="White">
            <TextBlock Text="[ DataGrid placeholder - Task 15 ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
        </Border>

    </Grid>
</Window>
